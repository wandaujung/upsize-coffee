FROM node:22-bookworm-slim AS frontend

WORKDIR /var/www

COPY . .

RUN npm install && npm run build

FROM php:8.3-apache-bookworm

WORKDIR /var/www

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    libzip-dev \
    && docker-php-ext-install pdo_mysql sockets zip \
    && a2enmod rewrite headers \
    && sed -ri 's!/var/www/html!/var/www/public!g' /etc/apache2/sites-available/*.conf /etc/apache2/apache2.conf \
    && sed -ri 's/Listen 80/Listen 10000/' /etc/apache2/ports.conf \
    && sed -ri 's/:80>/:10000>/' /etc/apache2/sites-available/*.conf \
    && printf '<Directory /var/www/public>\n    AllowOverride All\n    Require all granted\n</Directory>\n' > /etc/apache2/conf-available/upsize.conf \
    && a2enconf upsize \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY . .

COPY --from=frontend /var/www/public/build /var/www/public/build

RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader \
    && mkdir -p storage/app/public \
    storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && cp -r deploy-assets/products storage/app/public/ \
    && rm -rf public/storage \
    && ln -s ../storage/app/public public/storage \
    && chown -R www-data:www-data storage bootstrap/cache

ENV PORT=10000

EXPOSE 10000

CMD ["apache2-foreground"]
